# Maintainer: xt0n1-t3ch
#
# Repackages the official release .deb, so no Rust or Node toolchain is needed.
# The deb also ships `pulse-dev-bridge`, a debug helper that is left out here.
# Pacman owns the files: /usr/bin/pulse is root-owned, so the in-app updater
# cannot replace it. Updates arrive by bumping pkgver and the checksums.
pkgname=pulse-analytics-bin
pkgver=1.9.7
pkgrel=1
pkgdesc='Local-first analytics for Claude Code, Codex, OpenCode, Command Code and Orion App, with Discord Rich Presence'
arch=('x86_64' 'aarch64')
url='https://github.com/xt0n1-t3ch/Pulse-Analytics'
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=('pulse-analytics')
conflicts=('pulse-analytics')
options=('!strip' '!debug')
_release="${url}/releases/download/v${pkgver}"
_tag="https://raw.githubusercontent.com/xt0n1-t3ch/Pulse-Analytics/v${pkgver}"
noextract=("${pkgname}-${pkgver}-x86_64.deb" "${pkgname}-${pkgver}-aarch64.deb")
source=("LICENSE-${pkgver}::${_tag}/LICENSE"
        "NOTICE-${pkgver}::${_tag}/NOTICE")
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::${_release}/pulse-linux-x64-Pulse_${pkgver}_amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::${_release}/pulse-linux-arm64-Pulse_${pkgver}_arm64.deb")
sha256sums=('007d857ddf691694c12c428ef8571d8424b2f38d66cdb0905a1f956e010daeb5'
            'aaa5ed53b2921b865f8a6c2a5fac1be6f483f37d937fdf156f1c13037763c9eb')
sha256sums_x86_64=('2c4217f8ee5a12daf79a379d8707ac62b4a4aa49182f88971f9026813807141d')
sha256sums_aarch64=('13349c22806e9d2280784a70c178249190e6b8d85642af8fbf0d908ab436654f')

package() {
  mkdir -p "${srcdir}/deb"
  cd "${srcdir}/deb"
  # A .deb is an ar archive that holds control.tar.* and data.tar.*.
  bsdtar -xf "${srcdir}/${pkgname}-${pkgver}-${CARCH}.deb"
  bsdtar -xf data.tar.*

  install -Dm755 usr/bin/pulse "${pkgdir}/usr/bin/pulse"
  install -Dm644 usr/share/applications/Pulse.desktop \
    "${pkgdir}/usr/share/applications/Pulse.desktop"
  for size in 32x32 128x128 256x256@2; do
    install -Dm644 "usr/share/icons/hicolor/${size}/apps/pulse.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}/apps/pulse.png"
  done

  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/NOTICE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
}
